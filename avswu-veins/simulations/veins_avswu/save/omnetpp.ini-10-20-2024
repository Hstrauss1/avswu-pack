[General]
cmdenv-express-mode = true
cmdenv-autoflush = true
cmdenv-status-frequency = 1s
# log levels are off, info, and debug
**.cmdenv-log-level = info

network = AvswuScenario

# relative image paths work, absolute paths do not work!
image-path = "../../../src/veins/images"

##########################################################
#            Simulation parameters                       #
##########################################################
debug-on-errors = false
print-undisposed = true

# simulation time
sim-time-limit = 1200s

# softare update size as iteraction variable (so it can be referenced later)
**.softwareUpdateSizeMB = ${size=1}

# erasure code parameters
# 1,0, 2,1, 6,3, 12,6, 18,9, 24,12
**.erasureCodeK = ${k=6}
**.erasureCodeM = ${m=3}

## number of dav,cav from rou.xml file
**.numberDAV = ${dav=400}
**.numberCAV = ${cav=600}

# change output file name based on iteration variables with software size
# get the parameters set
output-vector-file = ${resultdir}/${configname}-${iterationvarsf}.vec
output-scalar-file = ${resultdir}/${configname}-${iterationvarsf}.sca

# set s/w size in each node
*.man[*].appl.softwareUpdateSizeMB = softwareUpdateSizeMB
*.rsu[*].appl.softwareUpdateSizeMB = softwareUpdateSizeMB
*.delivery[*].appl.softwareUpdateSizeMB = softwareUpdateSizeMB
*.node[*].appl.softwareUpdateSizeMB = softwareUpdateSizeMB

# set erasure code k,m in manufacturer
*.man[*].appl.erasureCodeK = erasureCodeK
*.man[*].appl.erasureCodeM = erasureCodeM

**.scalar-recording = true
**.vector-recording = true

*.playgroundSizeX = 4000m
*.playgroundSizeY = 4000m
*.playgroundSizeZ = 50m


##########################################################
# Annotation parameters                                  #
##########################################################
*.annotations.draw = true

##########################################################
# Obstacle parameters                                    #
##########################################################
*.obstacles.obstacles = xmldoc("config.xml", "//AnalogueModel[@type='SimpleObstacleShadowing']/obstacles")

##########################################################
#            TraCIScenarioManager parameters             #
##########################################################
*.manager.updateInterval = 1s
*.manager.host = "localhost"
*.manager.port = 9999
*.manager.autoShutdown = true
*.manager.launchConfig = xmldoc("erlangen.launchd.xml")
*.manager.trafficLightModuleType = "org.car2x.veins.nodes.TrafficLight"

##########################################################
# two vehicle types
##########################################################
*.manager.moduleType = "deliveryType=org.car2x.veins.nodes.Car *=org.car2x.veins.nodes.Car"
*.manager.moduleName = "deliveryType=delivery *=node"


*.tls[*].mobility.x = 0
*.tls[*].mobility.y = 0
*.tls[*].mobility.z = 3

*.tls[*].applType = "org.car2x.veins.modules.application.traci.TraCIDemoTrafficLightApp"
*.tls[*].logicType ="org.car2x.veins.modules.world.traci.trafficLight.logics.TraCITrafficLightSimpleLogic"

##########################################################
#                 manufacturer SETTINGS                  #
##########################################################
*.man[0].mobility.x = 3000
*.man[0].mobility.y = 1200
*.man[0].mobility.z = 3

*.man[*].applType = "avswu.veins_avswu.AvswuManufacturer11p"
*.man[*].appl.headerLength = 80 bit
*.man[*].appl.sendBeacons = false
*.man[*].appl.dataOnSch = false
*.man[*].appl.beaconInterval = 1s
*.man[*].appl.beaconUserPriority = 7
*.man[*].appl.dataUserPriority = 5
*.man[*].nic.phy80211p.antennaOffsetZ = 0 m

##########################################################
#                       RSU SETTINGS                     #
##########################################################
*.rsu[0].mobility.x = 1700
*.rsu[0].mobility.y = 1800
*.rsu[0].mobility.z = 3

*.rsu[1].mobility.x = 700
*.rsu[1].mobility.y = 1000
*.rsu[1].mobility.z = 3

*.rsu[2].mobility.x = 1800
*.rsu[2].mobility.y = 800
*.rsu[2].mobility.z = 3

*.rsu[3].mobility.x = 500
*.rsu[3].mobility.y = 600
*.rsu[3].mobility.z = 3

*.rsu[*].applType = "avswu.veins_avswu.AvswuRSU11p"
*.rsu[*].appl.headerLength = 80 bit
*.rsu[*].appl.sendBeacons = false
*.rsu[*].appl.dataOnSch = false
*.rsu[*].appl.beaconInterval = 1s
*.rsu[*].appl.beaconUserPriority = 7
*.rsu[*].appl.dataUserPriority = 5
*.rsu[*].nic.phy80211p.antennaOffsetZ = 0 m

##########################################################
#            11p specific parameters                     #
#                    NIC-Settings                        #
##########################################################
*.connectionManager.sendDirect = true
*.connectionManager.maxInterfDist = 2600m
*.connectionManager.drawMaxIntfDist = false

*.**.nic.mac1609_4.useServiceChannel = false

*.**.nic.mac1609_4.txPower = 20mW
*.**.nic.mac1609_4.bitrate = 6Mbps
*.**.nic.phy80211p.minPowerLevel = -110dBm

*.**.nic.phy80211p.useNoiseFloor = true
*.**.nic.phy80211p.noiseFloor = -98dBm

*.**.nic.phy80211p.decider = xmldoc("config.xml")
*.**.nic.phy80211p.analogueModels = xmldoc("config.xml")
*.**.nic.phy80211p.usePropagationDelay = true

*.**.nic.phy80211p.antenna = xmldoc("antenna.xml", "/root/Antenna[@id='monopole']")
*.node[*].nic.phy80211p.antennaOffsetY = 0 m
*.node[*].nic.phy80211p.antennaOffsetZ = 1.895 m


##########################################################
# delivery
##########################################################
*.delivery[*].applType = "avswu.veins_avswu.AvswuDeliveryAV11p"
*.delivery[*].appl.headerLength = 80 bit
*.delivery[*].appl.sendBeacons = false
*.delivery[*].appl.dataOnSch = false
*.delivery[*].appl.beaconInterval = 1s

##########################################################
#                      Mobility                          #
##########################################################
*.delivery[*].veinsmobility.x = 0
*.delivery[*].veinsmobility.y = 0
*.delivery[*].veinsmobility.z = 0
*.delivery[*].veinsmobility.setHostSpeed = false

##########################################################
# client node
##########################################################
*.node[*].applType = "avswu.veins_avswu.AvswuClientAV11p"
*.node[*].appl.headerLength = 80 bit
*.node[*].appl.sendBeacons = false
*.node[*].appl.dataOnSch = false
*.node[*].appl.beaconInterval = 1s

##########################################################
#                      Mobility                          #
##########################################################
*.node[*].veinsmobility.x = 0
*.node[*].veinsmobility.y = 0
*.node[*].veinsmobility.z = 0
*.node[*].veinsmobility.setHostSpeed = false

[Config Default]

[Config WithBeaconing]
*.rsu[*].appl.sendBeacons = true
*.node[*].appl.sendBeacons = true
*.delivery[*].appl.sendBeacons = true

[Config WithChannelSwitching]
*.**.nic.mac1609_4.useServiceChannel = true
*.node[*].appl.dataOnSch = true
*.delivery[*].appl.dataOnSch = true
*.rsu[*].appl.dataOnSch = true